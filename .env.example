# ============================================================================
# Kawaii Slime Company - Business Expense & Receipt Submission & App Hub
# Environment Configuration Template
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Supabase Database Configuration
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
VITE_SUPABASE_URL=https://your-project.supabase.co

# ----------------------------------------------------------------------------
# 2. Session Security
# ----------------------------------------------------------------------------
# HMAC-SHA256 secret for signing 24h session and expense access tokens
FINANCE_SESSION_SECRET=your_32_char_random_hex_or_secret
HQ_SESSION_SECRET=your_32_char_random_hex_or_secret

# ----------------------------------------------------------------------------
# 3. Slack App Credentials (/expense Slash Command & Interactivity)
# ----------------------------------------------------------------------------
# Bot User OAuth Token with scopes: commands, chat:write, files:read, files:write, users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Signing Secret from Slack App > Basic Information > App Credentials
SLACK_SIGNING_SECRET=your_slack_signing_secret

# ----------------------------------------------------------------------------
# 4. Target Slack Notification Channels
# ----------------------------------------------------------------------------
# Reimbursements: Employee paid personal card/funds and needs reimbursement -> #finance-reimbursements
SLACK_REIMBURSEMENT_CHANNEL_ID=C0123456789
SLACK_CHANNEL_REIMBURSEMENTS=C0123456789

# Company Card Receipts: Company card or company account was used -> #ap-domestic-receipts
SLACK_AP_RECEIPTS_CHANNEL_ID=C9876543210
SLACK_CHANNEL_AP_RECEIPTS=C9876543210

# ----------------------------------------------------------------------------
# 5. Hub Authentication Accounts (api/auth.js)
# ----------------------------------------------------------------------------
# Format: <PREFIX>_USERNAME, <PREFIX>_PASSWORD, <PREFIX>_ROLE, <PREFIX>_NAME
BLAKELI_USERNAME=blakeli
BLAKELI_PASSWORD=change_me
BLAKELI_ROLE=Admin
BLAKELI_NAME=Blakeli

CARLA_USERNAME=carla
CARLA_PASSWORD=change_me
CARLA_ROLE=Supervisor
CARLA_NAME=Carla

CHARLES_USERNAME=charles
CHARLES_PASSWORD=change_me
CHARLES_ROLE=Supervisor
CHARLES_NAME=Charles

CHRIS_USERNAME=chris
CHRIS_PASSWORD=change_me
CHRIS_ROLE=Supervisor
CHRIS_NAME=Chris

JUNAID_USERNAME=junaid
JUNAID_PASSWORD=change_me
JUNAID_ROLE=Admin
JUNAID_NAME=Junaid

ROXY_USERNAME=roxy
ROXY_PASSWORD=change_me
ROXY_ROLE=Supervisor
ROXY_NAME=Roxy

SANDRA_USERNAME=sandra
SANDRA_PASSWORD=change_me
SANDRA_ROLE=Payroll
SANDRA_NAME=Sandra

PAYROLL_USERNAME=payroll
PAYROLL_PASSWORD=change_me
PAYROLL_ROLE=Payroll
PAYROLL_NAME=Payroll

HUMAN_RESOURCES_USERNAME=hr
HUMAN_RESOURCES_PASSWORD=change_me
HUMAN_RESOURCES_ROLE=HR
HUMAN_RESOURCES_NAME=Human Resources
